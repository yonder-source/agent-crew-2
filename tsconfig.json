{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": ["src/config.mjs"],
  "include": ["src/**/*.ts", "src/**/*.cts", "src/**/*.mts", "src/**/*.js", "src/**/*.cjs", "src/**/*.mjs"]
}
