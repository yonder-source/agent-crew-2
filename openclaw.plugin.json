{
  "id": "agent-crew",
  "name": "Agent Crew",
  "description": "Agent Crew GitHub issue discovery and assigned issue access",
  "version": "0.1.0",
  "kind": "plugin",
  "uiCapabilities": ["page", "navigation"],
  "controlUi": {
    "entry": "dist/control-ui/agent-crew/setup.js",
    "styles": ["dist/control-ui/agent-crew/setup.css"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["environment"],
    "properties": {
      "environment": { "type": "string", "minLength": 1 },
      "slack": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "coding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agentId",
              "channelId",
              "userIds"
            ],
            "properties": {
              "agentId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "channelId": {
                "type": "string",
                "pattern": "^[CG][A-Z0-9]+$"
              },
              "userIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[UW][A-Z0-9]+$"
                }
              }
            }
          },
          "designer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agentId",
              "channelId",
              "userIds"
            ],
            "properties": {
              "agentId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "channelId": {
                "type": "string",
                "pattern": "^[CG][A-Z0-9]+$"
              },
              "userIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[UW][A-Z0-9]+$"
                }
              }
            }
          }
        }
      },
      "github": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository"],
        "properties": {
          "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "appId": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
          "installationId": { "type": "integer", "minimum": 1 },
          "pollIntervalMs": { "type": "integer", "minimum": 10000, "maximum": 3600000 }
        }
      },
      "coding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositoryPath"],
        "properties": {
          "agentId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$", "default": "coding" },
          "repositoryPath": { "type": "string", "pattern": "^/" }
        }
      }
    }
  },
  "contracts": { "tools": ["agent_crew_status", "agent_crew_environment", "agent_crew_issue_read", "agent_crew_issue_update"] },
  "activation": { "onStartup": true }
}
