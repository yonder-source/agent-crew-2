{
  "name": "agent-crew-openclaw-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit false",
    "lint": "eslint . --max-warnings=0",
    "check:lint": "node scripts/check-lint.mjs",
    "typecheck": "tsc --noEmit",
    "check:config": "node scripts/check-config.mjs",
    "check:gateway": "node scripts/check-gateway.mjs"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "typebox": "1.3.35"
  },
  "peerDependencies": { "openclaw": "2026.11.3" },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": { "pluginApi": "2026.11.3" },
    "build": { "openclawVersion": "2026.11.3" }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
