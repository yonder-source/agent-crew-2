    "check:config": "node scripts/check-config.mjs",
    "check:gateway": "node scripts/check-gateway.mjs"
  },
  "dependencies": {
    "typebox": "1.3.35"
  },
  "peerDependencies": {
    "openclaw": "2026.11.3"
